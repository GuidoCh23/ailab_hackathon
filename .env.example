# =====================================================================
# Variables de entorno del chatbot de catálogo (AI//LAB)
# Copia este archivo como `.env` y completa los valores.
# El archivo `.env` NUNCA se sube a GitHub (está en .gitignore).
# =====================================================================

# --- Groq (modelo de lenguaje) ---------------------------------------
# Crear en https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: claves de respaldo, se usan cuando la anterior se queda sin cuota
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Modelos: ligero para tareas simples, potente para tareas pesadas (ver https://console.groq.com/docs/models)
GROQ_MODEL_LIGERO=qwen/qwen3.8-27b
GROQ_MODEL_POTENTE=openai/gpt-oss-120b

# --- Gemini (embeddings) -------------------------------------------
# Crear en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Google Cloud / BigQuery -----------------------------------------
# ID del proyecto sandbox donde están cargados los datos dummy
GCP_PROJECT_ID=ailab-512816
# Ruta al JSON de la cuenta de servicio (solo lectura) de BigQuery.
# Guárdalo dentro de la carpeta credenciales/ (también está en .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=credenciales/bigquery-lectura.json
# Ubicación de los datasets
BQ_LOCATION=US
# Límite de bytes por consulta del agente de datos (1 GB)
BQ_MAX_BYTES_BILLED=1000000000

# --- GitHub (solo referencia para publicar en Streamlit Cloud) -------
# La app no usa estas variables; sirven para recordar dónde está el repo.
GITHUB_USER=GuidoCh23
GITHUB_REPO=ailab-catalogo
